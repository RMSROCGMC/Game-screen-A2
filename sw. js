const CACHE_NAME = 'tkms-pwa-v1';

// 這裡列出所有 GitHub Pages 需要快取的檔案
const ASSETS = [
  './',
  './index.html',
  './game.js',
  './style.css',
  './manifest.json',
  './icon.png'
];

// 安裝 Service Worker
self.addEventListener('install', (event) => {
  event.waitUntil(
    caches.open(CACHE_NAME).then((cache) => {
      console.log('正在預載校園資源...');
      return cache.addAll(ASSETS);
    })
  );
});

// 攔截網路請求，優先從快取讀取（離線遊玩關鍵）
self.addEventListener('fetch', (event) => {
  event.respondWith(
    caches.match(event.request).then((response) => {
      return response || fetch(event.request);
    })
  );
});
